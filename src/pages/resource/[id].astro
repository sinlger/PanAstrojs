---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDB, queryResources } from "@/server/db";
import { formatTimeAgo, formatBytes } from "@/lib/utils";

const { id } = Astro.params;
const db = getDB(Astro);

if (!id) {
  return Astro.redirect("/404");
}

// 1. Get Resource Details
const resourceQuery = `
  SELECT 
    r.*, 
    c.name as category_name 
  FROM resources r
  LEFT JOIN categories c ON r.category_id = c.id
  WHERE r.id = ?
`;
const resources = await queryResources(db, resourceQuery, [id]);

if (resources.length === 0) {
  return Astro.redirect("/404");
}

const resource = resources[0];

// 2. Get Links
const linksQuery = `
  SELECT 
    rl.*, 
    nt.name as source_name, 
    nt.code as source_code 
  FROM resource_links rl
  LEFT JOIN netdisk_types nt ON rl.type_id = nt.id
  WHERE rl.resource_id = ?
`;
const links = await queryResources(db, linksQuery, [id]);

// 3. Get Tags
const tagsQuery = `
  SELECT t.name 
  FROM tags t
  JOIN resource_tag_refs rtr ON t.id = rtr.tag_id
  WHERE rtr.resource_id = ?
`;
const tags = await queryResources(db, tagsQuery, [id]);

// Helper for netdisk styles
const getNetdiskConfig = (code: string) => {
  const c = (code || "").toLowerCase();
  if (c.includes("ali") || c.includes("阿里")) {
    return {
      bg: "bg-orange-50",
      text: "text-orange-600",
      btnClass: "bg-orange-500 hover:bg-orange-600 shadow-orange-500/20",
      iconPath: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5",
      isFill: true
    };
  }
  if (c.includes("baidu") || c.includes("百度")) {
    return {
      bg: "bg-blue-50",
      text: "text-blue-600",
      btnClass: "bg-blue-600 hover:bg-blue-700 shadow-blue-500/20",
      iconPath: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
      isStroke: true
    };
  }
  if (c.includes("quark") || c.includes("夸克")) {
    return {
      bg: "bg-blue-50",
      text: "text-blue-500",
      btnClass: "bg-blue-500 hover:bg-blue-600 shadow-blue-500/20",
      iconPath: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z",
      isFill: true
    };
  }
  // Default (PikPak, Xunlei, etc.)
  return {
    bg: "bg-slate-50",
    text: "text-slate-600",
    btnClass: "bg-slate-800 hover:bg-slate-900 shadow-slate-500/20",
    iconPath: "M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z",
    isFill: true
  };
};
---

<BaseLayout>
  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- 核心资源信息 (Table: resources) -->
    <div class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <!-- 对应 categories 表 -->
        <span
          class="px-3 py-1 bg-blue-50 text-blue-600 text-xs font-black rounded-full border border-blue-100 uppercase tracking-tight"
          >{resource.category_name || "未分类"}</span
        >
        <!-- 对应 status 字段 (1:正常, 2:失效, 0:待审) -->
        {resource.status === 1 ? (
          <span
            class="px-3 py-1 bg-green-50 text-green-600 border-green-100 text-[10px] font-black rounded-full border flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            有效收录
          </span>
        ) : resource.status === 2 ? (
          <span
            class="px-3 py-1 bg-red-50 text-red-600 border-red-100 text-[10px] font-black rounded-full border flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            已失效
          </span>
        ) : (
          <span
            class="px-3 py-1 bg-yellow-50 text-yellow-600 border-yellow-100 text-[10px] font-black rounded-full border flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
            待审核
          </span>
        )}
        <!-- 对应 updated_at -->
        <span class="text-xs text-slate-500 font-medium ml-auto"
          >更新于：{formatTimeAgo(resource.updated_at || resource.created_at)}</span
        >
      </div>

      <h1
        class="text-3xl md:text-4xl font-black text-slate-900 leading-tight mb-6"
      >
        {resource.title}
      </h1>

      <!-- 动态标签 (Table: tags via resource_tag_refs) -->
      <div class="flex flex-wrap gap-2 mb-8">
        {tags.map((tag: any) => (
          <span
            class="px-2.5 py-1 bg-slate-100 text-slate-700 text-[11px] font-bold rounded-md hover:bg-slate-200 cursor-pointer"
          >
            #{tag.name}
          </span>
        ))}
        {tags.length === 0 && <span class="text-xs text-slate-500">暂无标签</span>}
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <!-- 下载链接聚合 (Table: resource_links) -->
        <section>
          <div class="flex items-center justify-between mb-6">
            <h3
              class="text-sm font-black text-slate-600 uppercase tracking-widest flex items-center gap-3"
            >
              下载资源链接库
            </h3>
            <span class="text-[10px] text-slate-500 font-bold italic"
              >共 {links.length} 个链接</span
            >
          </div>

          <div class="space-y-4">
            {links.map((link: any) => {
              const config = getNetdiskConfig(link.source_code);
              // 如果链接无效(is_valid=0)，显示失效样式
              if (link.is_valid === 0) {
                 return (
                  <div
                    class="glass-card rounded-[1.5rem] p-5 border-dashed border-slate-200 bg-slate-50 opacity-60"
                  >
                    <div class="flex items-center gap-4">
                      <div
                        class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center shrink-0"
                      >
                        <svg
                          class="w-6 h-6"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          ><path
                            d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"
                            stroke-width="2"></path></svg
                        >
                      </div>
                      <div class="flex-grow">
                        <h4 class="text-sm font-black text-slate-500">
                          {link.source_name || "未知网盘"} (已失效)
                        </h4>
                        <p class="text-xs text-slate-400 italic">
                          链接已被系统标记为失效，等待管理员补档
                        </p>
                      </div>
                      <button
                        class="px-4 py-2 bg-slate-200 text-slate-600 text-[10px] font-black rounded-lg cursor-not-allowed"
                        >无法访问</button
                      >
                    </div>
                  </div>
                 );
              }

              // 有效链接
              return (
                <div
                  class="glass-card rounded-[1.5rem] p-5 border-slate-100 hover:shadow-xl hover:shadow-blue-500/5 transition-all group"
                >
                  <div class="flex flex-wrap items-center gap-4">
                    <!-- 网盘图标/名称 -->
                    <div
                      class={`w-12 h-12 rounded-2xl ${config.bg} ${config.text} flex items-center justify-center shrink-0`}
                    >
                      <svg class="w-6 h-6" fill={config.isFill ? "currentColor" : "none"} stroke={config.isStroke ? "currentColor" : "none"} viewBox="0 0 24 24">
                        <path
                          d={config.iconPath}
                          stroke-width={config.isStroke ? "2" : "0"}
                        ></path>
                      </svg>
                    </div>
                    <div class="flex-grow min-w-[200px]">
                      <div class="flex items-center gap-2 mb-1">
                        <h4 class="text-sm font-black text-slate-800">{link.source_name || "未知网盘"}</h4>
                        <!-- share_password 逻辑判断 -->
                        {link.share_password ? (
                           <div class="relative group/code">
                              <button
                                onclick={`navigator.clipboard.writeText('${link.share_password}')`}
                                class="relative px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-black rounded border border-blue-100 flex items-center gap-1 hover:bg-blue-100 transition-colors"
                              >
                                提取码: {link.share_password}
                                <svg
                                  class="w-3 h-3"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                  ><path
                                    d="M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"
                                    stroke-width="2"></path></svg
                                >
                              </button>
                           </div>
                        ) : (
                          <span
                            class="px-1.5 py-0.5 bg-slate-100 text-slate-500 text-[9px] font-black rounded uppercase"
                            >无需提取码</span
                          >
                        )}
                        <!-- is_valid 状态 -->
                        <span class="text-[9px] font-bold text-green-600 ml-auto"
                          >链接正常</span
                        >
                      </div>
                      <!-- remark 字段 -->
                      <p class="text-xs text-slate-500">
                        {link.remark || "官方不限速，建议及时保存"}
                      </p>
                    </div>
                    <div class="flex items-center gap-3 ml-auto">
                      <div class="text-right hidden sm:block">
                        <p
                          class="text-[10px] text-slate-400 font-bold uppercase tracking-tighter"
                        >
                          {link.sharer_name ? "Sharer" : "Size"}
                        </p>
                        <p class="text-xs font-bold text-slate-700">{link.sharer_name || formatBytes(link.file_size)}</p>
                      </div>
                      <a
                        href={link.share_url}
                        target="_blank" 
                        rel="noopener noreferrer"
                        class={`px-6 py-2.5 ${config.btnClass} text-white text-xs font-black rounded-xl transition-all shadow-lg`}
                        >立即前往</a
                      >
                    </div>
                  </div>
                </div>
              );
            })}
            
            {links.length === 0 && (
              <div class="text-center py-10 bg-slate-50 rounded-2xl border border-dashed border-slate-200 text-slate-500">
                暂无下载链接
              </div>
            )}
          </div>
        </section>

        <!-- 文件详细清单 (Field: file_info) -->
        {resource.file_info && (
          <section class="glass-card rounded-[2rem] p-8">
            <div class="flex items-center justify-between mb-8">
              <h3
                class="text-lg font-black text-slate-800 flex items-center gap-2"
              >
                <svg
                  class="w-5 h-5 text-indigo-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path d="M4 6h16M4 12h16M4 18h7" stroke-width="2"></path></svg
                >
                资源详细清单
              </h3>
              {resource.tg_msg_id && (
                <span class="text-[10px] text-blue-500 font-bold">
                  TG MSG ID #{resource.tg_msg_id}
                </span>
              )}
            </div>

            <div
              class="bg-slate-50 rounded-2xl p-6 font-mono text-xs text-slate-700 leading-relaxed whitespace-pre-wrap border border-slate-100"
            >
              {resource.file_info}
            </div>
          </section>
        )}

        <!-- 资源详情 (Field: description) -->
        <section class="glass-card rounded-[2rem] p-8">
          <h3
            class="text-lg font-black text-slate-800 mb-6 uppercase tracking-tight"
          >
            内容描述
          </h3>
          <div
            class="prose prose-slate max-w-none text-sm text-slate-800 leading-relaxed space-y-4 whitespace-pre-wrap"
          >
            {resource.description || "暂无描述..."}
          </div>
        </section>
      </div>

      <!-- 右侧边栏 (关联信息) -->
      <div class="space-y-8">
        <!-- 监控信息 (Table: channels) -->
        <div class="p-6 bg-slate-900 rounded-[2rem] text-white">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center font-black"
            >
              C
            </div>
            <div>
              <p
                class="text-[10px] text-slate-400 font-bold uppercase tracking-tighter"
              >
                Source Channel
              </p>
              <h4 class="text-sm font-black tracking-tight">Cloud Assets HD</h4>
            </div>
          </div>
          <div class="space-y-4 mb-6">
            <div class="flex justify-between text-xs">
              <span class="text-slate-500 font-bold">同步优先级</span>
              <span class="text-blue-400 font-black">P1 (高)</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-slate-500 font-bold">资源 ID</span>
              <span class="text-slate-300 font-bold">#{resource.id}</span>
            </div>
          </div>
          <button
            class="w-full py-3 bg-white/10 hover:bg-white/20 rounded-xl text-xs font-black transition-all"
            >关注来源频道</button
          >
        </div>

        <!-- 快速工具 (Triggers & Monitor) -->
        <div class="glass-card rounded-[2rem] p-6">
          <h3
            class="text-xs font-black text-slate-500 uppercase tracking-widest mb-6"
          >
            资源维护
          </h3>
          <div class="grid grid-cols-2 gap-3">
            <button
              class="flex flex-col items-center justify-center p-4 bg-slate-50 rounded-2xl hover:bg-red-50 hover:text-red-500 transition-all border border-transparent hover:border-red-100"
            >
              <svg
                class="w-6 h-6 mb-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  stroke-width="2"></path></svg
              >
              <span class="text-[10px] font-black">报错失效</span>
            </button>
            <button
              class="flex flex-col items-center justify-center p-4 bg-slate-50 rounded-2xl hover:bg-blue-50 hover:text-blue-500 transition-all border border-transparent hover:border-blue-100"
            >
              <svg
                class="w-6 h-6 mb-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  stroke-width="2"></path></svg
              >
              <span class="text-[10px] font-black">主动校验</span>
            </button>
          </div>
        </div>

        <!-- 性能索引提示 (UI/UX) -->
        <div
          class="p-8 bg-indigo-600 rounded-[2rem] text-white relative overflow-hidden"
        >
          <div class="relative z-10">
            <h4 class="text-sm font-black mb-2">FTS5 全文检索</h4>
            <p class="text-[11px] text-indigo-100/70 leading-relaxed">
              系统已为该资源建立实时全文索引，您可以直接在搜索框输入“存档”、“4K”或描述中的任何关键词快速定位。
            </p>
          </div>
          <svg
            class="absolute -right-6 -bottom-6 w-24 h-24 text-white/10 rotate-12"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
          >
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
