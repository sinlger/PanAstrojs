---
import { getDB, queryResources } from "@/server/db";
import { ResourceRecommender } from "@/components/react/ResourceRecommender";

const db = getDB(Astro);
const categories = await queryResources(db, "SELECT * FROM categories ORDER BY id ASC");
const resourceCountResult = await queryResources(db, "SELECT COUNT(*) as count FROM resources");
const totalResources = resourceCountResult[0]?.count || 0;

const latestResources = await queryResources(
  db,
  `SELECT 
    r.id, 
    r.title, 
    r.created_at,
    rl.file_size, 
    nt.code as source_code,
    nt.name as source_name,
    c.name as category_name,
    rl.share_url
  FROM resources r
  LEFT JOIN resource_links rl ON r.id = rl.resource_id
  LEFT JOIN netdisk_types nt ON rl.type_id = nt.id
  LEFT JOIN categories c ON r.category_id = c.id
  WHERE r.status = 1
  GROUP BY r.id
  ORDER BY r.created_at DESC
  LIMIT 12`
);
---

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <ResourceRecommender 
    client:load 
    initialResources={latestResources} 
    categories={categories}
    totalResources={totalResources}
  />
</main>
