---
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Search } from "lucide-react";
---

<section class="overflow-hidden">
  <header class="py-16 md:py-24 px-4 bg-white relative overflow-hidden">
    <!-- 装饰性背景 -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full opacity-10 pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[10%] w-72 h-72 bg-blue-400 rounded-full blur-[100px]"
      >
      </div>
      <div
        class="absolute bottom-[10%] right-[10%] w-72 h-72 bg-indigo-400 rounded-full blur-[100px]"
      >
      </div>
    </div>

    <div class="max-w-3xl mx-auto text-center relative z-10">
      <h1
        class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 tracking-tight"
      >
        搜你所想，直达网盘
      </h1>
      <p class="text-lg text-slate-500 mb-10">
        收录超过 100,000+ 高质量资源，实时检测链接有效性
      </p>

      <!-- 搜索框 -->
      <form action="/search" method="GET" class="relative group max-w-2xl mx-auto">
        <div
          class="relative transition-transform duration-300 hover:scale-[1.01]"
        >
          <Input
            name="q"
            type="text"
            placeholder="输入电影、书籍、软件关键词..."
            className="w-full pl-6 pr-36 py-4 md:py-7 bg-white/80 backdrop-blur-xl border border-slate-200/60 rounded-2xl text-lg shadow-2xl shadow-blue-900/5 focus-visible:ring-4 focus-visible:ring-blue-500/10 focus-visible:border-blue-500 transition-all placeholder:text-slate-400 h-auto"
          />
          <div class="absolute right-2 top-2 bottom-2">
            <Button
              type="submit"
              className="h-full px-6 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 text-base transition-all hover:shadow-blue-500/40"
            >
              搜索
            </Button>
          </div>
        </div>
      </form>

      <!-- 热门搜索标签 -->
      <div
        class="mt-6 flex flex-wrap justify-center gap-2 text-sm text-slate-400"
      >
        <span>热门搜索：</span>
        <a href="#" class="hover:text-blue-500 underline decoration-dotted"
          >死侍与金刚狼</a
        >
        <a href="#" class="hover:text-blue-500 underline decoration-dotted"
          >黑神话悟空</a
        >
        <a href="#" class="hover:text-blue-500 underline decoration-dotted"
          >2026考研资料</a
        >
      </div>
    </div>
  </header>
</section>
