---
const { pathname } = Astro.url;
const isHome = pathname === "/";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Search } from "lucide-react";
---
<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200"> 
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"> 
        <div class="flex justify-between h-16 items-center"> 
            <div class="flex items-center gap-8">
                <a href="/" class="flex items-center gap-2"> 
                    <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold">P</div> 
                    <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600"> 
                        云盘聚合 
                    </span> 
                </a>

                {
                    !isHome && (
                        <form action="/search" method="GET" class="hidden md:flex relative group w-96">
                            <div class="relative w-full transition-transform duration-300 hover:scale-[1.01]">
                                <Input
                                    name="q"
                                    type="text"
                                    placeholder="输入关键词搜索..."
                                    className="w-full pl-4 pr-12 py-2 bg-slate-100/50 border-slate-200 rounded-xl text-sm focus-visible:ring-2 focus-visible:ring-blue-500/10 focus-visible:border-blue-500 transition-all h-10"
                                />
                                <div class="absolute right-1 top-1 bottom-1">
                                    <Button
                                        type="submit"
                                        size="icon"
                                        className="h-8 w-8 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow-sm transition-all"
                                    >
                                        <Search className="w-4 h-4" />
                                    </Button>
                                </div>
                            </div>
                        </form>
                    )
                }
            </div>

            <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-600"> 
                <a href="#" class="hover:text-blue-600 transition-colors">最新资源</a> 
                <a href="#" class="hover:text-blue-600 transition-colors">热门分类</a> 
                <a href="#" class="hover:text-blue-600 transition-colors">求片留言</a> 
                <a href="https://t.me/your_channel" target="_blank" class="flex items-center gap-1 text-blue-500 bg-blue-50 px-3 py-1.5 rounded-full hover:bg-blue-100 transition-all"> 
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .33z"/></svg> 
                    TG 频道 
                </a> 
            </div> 
        </div> 
    </div> 
</nav>
